{
  "name": "listenin-backend",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "api:lint": "redocly lint openapi.yaml --config redocly.lint.yaml",
    "api:docs": "redocly build-docs openapi.yaml --config redocly.lint.yaml --output dist/api-docs.html",
    "api:types": "openapi-typescript openapi.yaml --output src/api/schema.d.ts && prettier --write src/api/schema.d.ts"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-openapi-validator": "^5.6.2",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "mongoose": "^9.12.3",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@redocly/cli": "^2.82.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "mongodb-memory-server": "^11.4.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  },
  "config": {
    "mongodbMemoryServer": {
      "version": "8.2.6"
    }
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
