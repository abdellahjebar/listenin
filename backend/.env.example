NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Origine de l'application web (serveur de développement Angular en local)
APP_ORIGIN=http://localhost:4200
# Base locale : docker run -d --name listenin-mongo -p 27017:27017 mongo:8
MONGODB_URI=mongodb://localhost:27017/listenin
# Proxys de confiance devant l'API : 0 en local, 1 derrière nginx (docker compose)
TRUST_PROXY=0
