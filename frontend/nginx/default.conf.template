server {
  listen 8080;
  root /usr/share/nginx/html;
  index index.html;

  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml;

  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;

  # Les fichiers JS et CSS générés par Angular portent un hachage dans leur nom : cache long sans risque.
  location ~* \.(?:js|css)$ {
    expires 1y;
    add_header Cache-Control "public, immutable";
    add_header X-Content-Type-Options "nosniff" always;
  }

  # API sous la même origine (ADR 0006) : nginx relaie /api vers le conteneur de l'API.
  # ${API_UPSTREAM} est remplacé au démarrage du conteneur (gabarit nginx, voir le Dockerfile).
  # « ^~ » : prioritaire sur la règle des fichiers .js et .css ci-dessus.
  location ^~ /api/ {
    proxy_pass ${API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    # L'API lit l'adresse du visiteur dans X-Forwarded-For (TRUST_PROXY=1).
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # L'API pose ses propres en-têtes de sécurité (helmet) : pas de doublon contradictoire.
    proxy_hide_header X-Content-Type-Options;
    proxy_hide_header X-Frame-Options;
    proxy_hide_header Referrer-Policy;
  }

  # Application monopage : toute route inconnue renvoie index.html, le routeur Angular prend le relais.
  location / {
    try_files $uri $uri/ /index.html;
  }
}
